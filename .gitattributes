# Default: normalize all text files to LF in the repo
* text=auto eol=lf

# Windows-specific files keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: no conversion
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.a binary
*.lib binary
